.idea/
*.iml
.vscode/
*.swp
*~

# ── Operating systems ─────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Secrets / local configuration ─────────────────────────
.env
.env.*
*.env
*.pem
*.key
secrets.*

# ── Claude Code ───────────────────────────────────────────
.claude/

# IMPORTANT: a global ignore file is also used on the author's machine.
