# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Packaging / build output
build/
dist/
*.egg-info/
.eggs/
*.egg
MANIFEST
pip-wheel-metadata/

# Virtual environments (never commit; recreate with requirements.txt)
venv/
.venv/
env/
ENV/
pyvenv.cfg

# Test, coverage and tool caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Jupyter
.ipynb_checkpoints/

# ── Editors / IDEs ────────────────────────────────────────
